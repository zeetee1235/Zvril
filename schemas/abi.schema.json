{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zvril explicit SysV ABI contract",
  "description": "Structural schema. The runtime validates sizes, masks, pointer overlap, variadic promotions and up to eight nested field layouts. Struct field offsets derive INTEGER/SSE/MEMORY/NO_CLASS and padding; overlapping union fields require explicit classes. C source prototypes are not inferred from machine code.",
  "oneOf": [
    {
      "$ref": "#/$defs/signature"
    },
    {
      "type": "object",
      "required": [
        "signature"
      ],
      "properties": {
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    }
  ],
  "$defs": {
    "argument": {
      "oneOf": [
        {
          "enum": [
            "u64",
            "i64",
            "u32",
            "i32",
            "f32",
            "f64",
            "ptr",
            "u8",
            "i8",
            "u16",
            "i16"
          ]
        },
        {
          "type": "object",
          "required": [
            "aggregate"
          ],
          "additionalProperties": false,
          "properties": {
            "aggregate": {
              "type": "object",
              "required": [
                "size",
                "alignment"
              ],
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "alignment": {
                  "enum": [
                    1,
                    2,
                    4,
                    8,
                    16
                  ]
                },
                "classes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "enum": [
                      "INTEGER",
                      "SSE",
                      "MEMORY",
                      "NO_CLASS"
                    ]
                  }
                },
                "defined_bytes": {
                  "type": "string",
                  "pattern": "^[01]+$"
                },
                "pointer_offsets": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4088
                  }
                },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "required": [
                      "offset",
                      "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "offset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4095
                      },
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "$ref": "#/$defs/field_type"
                      }
                    }
                  }
                }
              },
              "anyOf": [
                {
                  "required": [
                    "classes"
                  ]
                },
                {
                  "required": [
                    "fields"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": [
        "return",
        "arguments"
      ],
      "additionalProperties": false,
      "properties": {
        "return": {
          "oneOf": [
            {
              "$ref": "#/$defs/argument"
            },
            {
              "const": "void"
            }
          ]
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "variadic": {
          "type": "boolean"
        },
        "fixed_arguments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "globals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "return_comparison": {
          "enum": [
            "bits",
            "sign"
          ]
        }
      }
    },
    "field_type": {
      "$ref": "#/$defs/argument"
    }
  }
}
